# Copy this file to .env and fill in your values.
# k6 reads these via __ENV. Load them with ./run.sh (which sources .env).

# --- Target API ---
API_URL=https://api.example.com/v1/health
API_KEY=your-api-key-here

# Customer identifier sent with every request.
# For GET/HEAD/DELETE it is appended as a query param: ...?cifNo=<value>
# For POST/PUT/PATCH it is sent as JSON body {"cifNo":"<value>"} when
# REQUEST_BODY is empty. Leave blank to omit.
CIF_NO=

# HTTP method and optional JSON body for the request
HTTP_METHOD=GET
# Provide a JSON string for POST/PUT/PATCH bodies, leave empty for GET.
REQUEST_BODY=

# Header used to send the API key. Common values: "Authorization" or "x-api-key".
# When Authorization is used, the value is prefixed with "Bearer ".
AUTH_HEADER=Authorization

# --- Load profile ---
# Peak number of virtual users to ramp up to.
MAX_VUS=200
# Ramp-up, sustain, and ramp-down durations (k6 duration syntax: 30s, 2m, 1h).
RAMP_UP=30s
SUSTAIN=1m
RAMP_DOWN=30s

# --- Thresholds (pass/fail criteria) ---
# Fail the test if p95 latency exceeds this many milliseconds.
P95_MAX_MS=500
# Fail the test if the HTTP error rate exceeds this fraction (0.01 = 1%).
MAX_ERROR_RATE=0.01

# Per-request timeout.
REQUEST_TIMEOUT=30s
# Seconds each VU sleeps between iterations.
SLEEP_SECONDS=1
